{
  "name": "copilotbus-llm-bridge",
  "displayName": "CopilotBus LLM Bridge",
  "description": "Answers llm requests from the shared-folder bus using GitHub Copilot models.",
  "publisher": "macavall",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotBus.start",
        "title": "CopilotBus: Start LLM Bridge"
      },
      {
        "command": "copilotBus.stop",
        "title": "CopilotBus: Stop LLM Bridge"
      }
    ],
    "configuration": {
      "title": "CopilotBus",
      "properties": {
        "copilotBus.root": {
          "type": "string",
          "default": "",
          "description": "Bus root folder. Empty = <home>/OneDrive - Microsoft/CopilotBus."
        },
        "copilotBus.modelFamily": {
          "type": "string",
          "default": "",
          "description": "Preferred Copilot model family (e.g. gpt-4o). Empty = first available Copilot model."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
